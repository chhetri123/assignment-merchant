# Copy to .env and replace every placeholder before running the API.
# Real secrets must never be committed.

NODE_ENV=development
PORT=3000

# Postgres — DB_PORT/REDIS_PORT are host-side ports (compose mapping + local
# runs). Change them if 5432/6379 are already taken on your machine.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=merchant
DB_PASSWORD=change-me-locally
DB_DATABASE=merchant

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
# Database index; e2e tests use 1 so they never share a queue with a running API.
REDIS_DB=0

# Auth — generate each secret with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-32-byte-random-hex-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-random-hex-string
JWT_REFRESH_EXPIRES_IN=7d

# Field-level encryption key for sensitive merchant data (tax id).
# Must be 32 bytes hex (64 chars). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars-00000000000000000000000000000000

# Risk job retry policy
RISK_JOB_ATTEMPTS=3
RISK_JOB_BACKOFF_MS=1000

# Seed users password (local development only)
SEED_PASSWORD=ChangeMe123!
